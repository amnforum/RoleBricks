APP_NAME=EmotionOS
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
AUTO_MIGRATE=false

# Explicit local development mode. Databricks Apps overrides this with Lakebase.
DATABASE_BACKEND=local
DATABASE_URL=sqlite+pysqlite:///./data/emotionos.db
LAKEBASE_ENDPOINT_NAME=
AUDIO_DATA_DIR=./data/emotionos_audio
MAX_AUDIO_SIZE_MB=25

# Deterministic local scene services; app.yaml selects Databricks in deployment.
SCENE_COMPILER_PROVIDER=rules
SCENE_RESEARCH_PROVIDER=none
SCENE_RETRIEVAL_PROVIDER=database
SCENE_WORKER_COUNT=2
SCENE_MAX_AGENTS=3

DATABRICKS_HOST=
DATABRICKS_SERVING_ENDPOINT=
DATABRICKS_AI_SEARCH_INDEX=main.emotionos_worlds.scene_memory_search_index
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=emotionos_worlds
DATABRICKS_TIMEOUT_SECONDS=90
MLFLOW_EXPERIMENT_ID=

# One provider is chosen before synthesis; failed requests never switch providers.
VOICE_PROVIDER=adaptive
ADAPTIVE_OPENAI_FEMININE_VOICE=marin
ADAPTIVE_OPENAI_MASCULINE_VOICE=cedar

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_RESEARCH_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_CUSTOM_VOICE_ID=
OPENAI_TIMEOUT_SECONDS=90

# Native Hindi, Hinglish, and Indian English route.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_FEMININE_SPEAKER=priya
SARVAM_MASCULINE_SPEAKER=shubh
SARVAM_PRONUNCIATION_DICT_ID=
SARVAM_SAMPLE_RATE=24000
SARVAM_TIMEOUT_SECONDS=90

# Optional consented voice route hosted separately on Hugging Face.
HF_TOKEN=
HF_SPACE_ID=madteddy/emotionos-inference
HF_SPACE_API_NAME=/generate
